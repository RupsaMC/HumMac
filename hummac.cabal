cabal-version:      3.0
name:               hummac
version:            0.1.0.0
synopsis:           Human-to-Machine Compiler
description:        An experimental compiler for controlled mathematical language.
license:            Apache-2.0
license-file:       LICENSE
author:             Rupsa Mandal Chakraborty
build-type:         Simple
extra-source-files:
    README.md
    docs/*.md
    examples/*.eng

library
    exposed-modules:
        Compiler
        Evaluator
        ExpressionInference
        InstructionAnalysis
        Parser
        PromotionResolution
        PropositionInference
        SMIR
        SemanticAnalysis
        SymbolTable
        SyntaxToSMIR
        Syntax
        Termination
        TypeChecker
        TypeInference
        TypeSystem

    hs-source-dirs:      src

    build-depends:
        base >=4.18 && <5,
        containers >=0.6

    default-language:    Haskell2010
    ghc-options:         -Wall

executable hummac
    main-is:             Main.hs
    hs-source-dirs:      app

    build-depends:
        base >=4.18 && <5,
        hummac,
        containers >=0.6

    default-language:    Haskell2010
    ghc-options:         -Wall
